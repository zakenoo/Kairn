<Application x:Class="Kairn.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Kairn.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <v:CategoryBrushConverter x:Key="CatBrush"/>
            <v:CategoryNameConverter x:Key="CatName"/>
            <v:NotNullToVisibilityConverter x:Key="NotNullVis"/>
            <v:ResourceIconConverter x:Key="ResIcon"/>
            <v:HexToBrushConverter x:Key="HexBrush"/>
            <v:ThumbConverter x:Key="Thumb"/>
            <v:SubtitleConverter x:Key="Subtitle"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
