<Window x:Class="Kairn.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kairn.Views"
        Title="Kairn" Width="1320" Height="820" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ZoneWindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" LayoutTransform="{DynamicResource UiScale}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== Barre latérale ===== -->
        <Border Background="{DynamicResource ZoneSidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,14,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,28">
                    <!-- Logo : un cairn, trois pierres empilées -->
                    <Canvas Width="22" Height="22" VerticalAlignment="Center">
                        <Ellipse Canvas.Left="1" Canvas.Top="14" Width="20" Height="6.5" Fill="{DynamicResource LogoBrush}"/>
                        <Ellipse Canvas.Left="4" Canvas.Top="8" Width="14" Height="5.5" Fill="{DynamicResource LogoBrush}" Opacity="0.85"/>
                        <Ellipse Canvas.Left="7" Canvas.Top="3" Width="8.5" Height="4.5" Fill="{DynamicResource LogoBrush}" Opacity="0.7"/>
                    </Canvas>
                    <TextBlock Text="Kairn" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tout en bas : le code source et un petit lien de soutien -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Border x:Name="KofiBtn" Cursor="Hand" CornerRadius="6" Padding="10,6" HorizontalAlignment="Stretch"
                            Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" ToolTip="{l:T side.kofi.tip}" MouseLeftButtonDown="Press" MouseLeftButtonUp="Kofi_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="☕" FontFamily="Segoe UI Emoji" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ko-fi" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Ghost}" Padding="4,3" Margin="0,6,0,0" FontSize="11.5" HorizontalAlignment="Center"
                            Click="Source_Click" ToolTip="{l:T side.source.tip}" Foreground="{DynamicResource FaintBrush}"
                            Content="github.com/zakenoo/Kairn"/>
                </StackPanel>


                <!-- Garde anti-distraction : raccourci visible en permanence -->
                <Border DockPanel.Dock="Bottom" x:Name="GuardCard" Background="{DynamicResource ZoneGuardBrush}"
                        CornerRadius="{DynamicResource Radius}" Padding="14,12" Cursor="Hand"
                        MouseLeftButtonDown="Press" MouseLeftButtonUp="GuardCard_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="GuardTitle" Text="Garde : Doux" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="GuardSub" Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0"
                                   Text="Rappel si Discord s'ouvre pendant le travail"/>
                    </StackPanel>
                </Border>

                <!-- Nouvelle version disponible (seulement si la personne a accepté les vérifications) -->
                <Border DockPanel.Dock="Bottom" x:Name="UpdateCard" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius}"
                        Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateSub" Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <Button x:Name="UpdateBtn" Style="{StaticResource Primary}" Content="{l:T update.install}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Padding="12,6" Click="Update_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavToday" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" Tag="today" AutomationProperties.Name="Aujourd'hui">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:T nav.today}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPlanning" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" Tag="planning" AutomationProperties.Name="Planning">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:T nav.planning}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGoals" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" Tag="goals" AutomationProperties.Name="Objectifs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:T nav.goals}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" Tag="library" AutomationProperties.Name="Bibliothèque">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:T nav.library}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGuard" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" Tag="guard" AutomationProperties.Name="Garde">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:T nav.guard}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" Tag="appearance" AutomationProperties.Name="Apparence">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:T nav.appearance}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" Tag="settings" AutomationProperties.Name="Réglages">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:T nav.settings}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Contenu ===== -->
        <ContentControl x:Name="Host" Grid.Column="1" Margin="0,40,0,0" Focusable="False"/>

        <!-- ===== Boutons de fenêtre ===== -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Min_Click" ToolTip="{l:T win.minimize}"/>
            <Button Style="{StaticResource TitleBarButton}" x:Name="MaxBtn" Content="&#xE922;" Click="Max_Click" ToolTip="{l:T win.maximize}"/>
            <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{l:T win.close}"/>
        </StackPanel>
    </Grid>
</Window>
