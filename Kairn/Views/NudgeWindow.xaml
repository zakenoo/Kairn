<Window x:Class="Kairn.Views.NudgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairn.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextBrush}" Opacity="0">
    <Border Margin="16" Width="360" Background="{DynamicResource ZoneNudgeBrush}" BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius}" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="9"
                        Content="&#xE8BB;" Click="Close_Click" Margin="0,-6,-8,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="Header" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                           Text="{l:T nudge.header}"/>
            </DockPanel>
            <TextBlock x:Name="TaskTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="Detail" Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{StaticResource Primary}" Content="{l:T nudge.back}" Click="Back_Click"/>
                <Button Style="{StaticResource Ghost}" Content="{l:T guard.snooze}" Margin="8,0,0,0" Click="Snooze_Click"
                        ToolTip="{l:T nudge.snooze.tip}"/>
            </StackPanel>
            <StackPanel x:Name="RhythmActions" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                <Button Style="{StaticResource Primary}" Content="{l:T rhythm.toast.ok}" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
