<UserControl x:Class="Kairn.Views.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairn.Views"
             xmlns:v="clr-namespace:Kairn.Views">
    <Grid>
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="44,8,44,40" MaxWidth="860" HorizontalAlignment="Left">
                <TextBlock Text="{l:T nav.appearance}" Style="{StaticResource H1}" FontSize="24"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,20"
                           Text="{l:T app.intro}"/>

                <!-- ===== Thèmes ===== -->
                <TextBlock Text="{l:T app.presets}" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="PresetList" Margin="0,0,0,18"/>

                <TextBlock Text="{l:T app.mine}" Style="{StaticResource Label}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <WrapPanel x:Name="CustomList"/>
                        <TextBlock x:Name="NoCustom" Style="{StaticResource Subtle}" Margin="0,0,0,12"
                                   Text="{l:T app.mine.empty}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Export_Click" ToolTip="{l:T app.export.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T plan.export}"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Import_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T plan.import}"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="8,0,0,0" Content="{l:T common.save}" Click="SaveTheme_Click"/>
                            <TextBox x:Name="ThemeName" Tag="{l:T app.themeName}" KeyDown="ThemeName_KeyDown"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Couleurs ===== -->
                <TextBlock Text="{l:T app.colors}" Style="{StaticResource Label}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <UniformGrid x:Name="ColorsGrid" Columns="2"/>
                        <CheckBox x:Name="DarkSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                  Content="{l:T app.dark}" Click="DarkSwitch_Click"/>
                    </StackPanel>
                </Border>

                <!-- ===== Icône de Kairn (barre des tâches, notification) ===== -->
                <TextBlock Text="{l:T app.icon}" Style="{StaticResource Label}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <DockPanel>
                        <Image x:Name="IconPreview" DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel>
                            <UniformGrid x:Name="IconColors" Columns="2"/>
                            <TextBlock Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Text="{l:T app.icon.sub}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== Blocs ===== -->
                <TextBlock Text="{l:T app.zones}" Style="{StaticResource Label}"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,10"
                           Text="{l:T app.zones.sub}"/>
                <StackPanel x:Name="ZonesPanel" Margin="0,0,0,24"/>

                <!-- ===== Forme et texte ===== -->
                <TextBlock Text="{l:T app.shape}" Style="{StaticResource Label}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{l:T app.font}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="FontChips"/>
                        <TextBox x:Name="FontSearch" Tag="{l:T app.fontSearch}" TextChanged="FontSearch_TextChanged" Margin="0,4,0,0"/>
                        <WrapPanel x:Name="FontResults" Margin="0,8,0,0"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T app.scale}" VerticalAlignment="Center"/>
                            <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.8" Maximum="1.4" SmallChange="0.05" VerticalAlignment="Center"
                                    ValueChanged="Shape_Changed" Thumb.DragCompleted="Scale_DragCompleted"/>
                            <TextBlock x:Name="ScaleText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}"/>

                            <TextBlock Grid.Row="1" Text="{l:T app.radius}" VerticalAlignment="Center"/>
                            <Slider x:Name="RadiusSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="28" VerticalAlignment="Center"
                                    ValueChanged="Shape_Changed"/>
                            <TextBlock x:Name="RadiusText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}"/>

                            <TextBlock Grid.Row="2" Text="{l:T app.border}" VerticalAlignment="Center"/>
                            <Slider x:Name="BorderSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3" VerticalAlignment="Center"
                                    ValueChanged="Shape_Changed"/>
                            <TextBlock x:Name="BorderText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Sélecteur de couleur flottant -->
        <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <v:ColorPicker x:Name="Picker" Margin="8"/>
        </Popup>
    </Grid>
</UserControl>
