<UserControl x:Class="Kairn.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairn.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid x:Name="Layout" Margin="36,8,36,40" MaxWidth="1320" SizeChanged="Layout_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition x:Name="GapCol" Width="24"/>
            <ColumnDefinition x:Name="SideCol" Width="310"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== En-tête ===== -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DateText" Style="{StaticResource Label}" FontSize="12.5" Text="SAMEDI 19 SEPTEMBRE"/>
                    <TextBlock x:Name="Greeting" Style="{StaticResource H1}" Text="Bonjour."/>
                    <TextBlock x:Name="Quote" Style="{StaticResource Subtle}" FontSize="14" Margin="0,8,0,0" MaxWidth="560"
                               HorizontalAlignment="Left" FontStyle="Italic"/>
                </StackPanel>

                <!-- Le cairn : une pierre par tâche accomplie. On montre ce qui est fait, jamais ce qui manque. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <!-- Ne montrer que l'essentiel : de quoi ne plus être submergé quand la journée est chargée -->
                        <ToggleButton x:Name="FocusToggle" Style="{StaticResource FocusChip}" HorizontalAlignment="Right"
                                      Margin="0,0,0,8" Click="FocusToggle_Click" ToolTip="{l:T today.focus.tip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="11" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:T today.focus}"/>
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock x:Name="DoneText" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FocusTimeText" HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="WeekText" HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
                        <!-- Le sentier : tout ce qui a été fait depuis le début. Ça ne fait que monter. -->
                        <TextBlock x:Name="PathText" HorizontalAlignment="Right" FontSize="11.5" Margin="0,6,0,0"
                                   Foreground="{DynamicResource FaintBrush}"/>
                    </StackPanel>
                    <Canvas x:Name="Cairn" Width="84" Height="112" ClipToBounds="False"/>
                </StackPanel>
            </Grid>

            <!-- ===== Tâche en cours ===== -->
            <Border x:Name="NowCard" Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource ZoneNowCardBrush}" Padding="24,22" Margin="0,0,0,28"
                    BorderBrush="{DynamicResource AccentBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource RadiusPill}" Padding="10,3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="12">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock x:Name="NowLabel" Text="{l:T today.label.now}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="NowRange" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="NowTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="NowNotes" Style="{StaticResource Subtle}" FontSize="14" Margin="0,10,0,0" LineHeight="21"/>

                        <!-- Les étapes : la seule chose à regarder quand la tâche entière paraît infaisable.
                             La prochaine non faite est mise en avant, les autres attendent tranquillement. -->
                        <StackPanel x:Name="NowStepsBox" Margin="0,16,0,0" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="NowStepsCount" DockPanel.Dock="Right" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T steps.title}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="NowSteps">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="srow" Padding="10,7" Margin="0,0,0,4" CornerRadius="{DynamicResource RadiusSmall}"
                                                Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" VerticalAlignment="Center"
                                                          Click="Step_Click" Tag="{Binding}" Margin="0,0,12,0"/>
                                                <TextBlock x:Name="stitle" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           MaxWidth="460"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                <Setter TargetName="srow" Property="Opacity" Value="0.42"/>
                                                <Setter TargetName="stitle" Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Ressources de la catégorie, à portée de main -->
                        <!-- Ce qu'il faut ouvrir pour cette tâche : un clic et c'est parti -->
                        <WrapPanel x:Name="NowLinks" Margin="0,14,0,0" Visibility="Collapsed"/>

                        <ItemsControl x:Name="NowResources" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Padding="10,6" Click="Resource_Click" Tag="{Binding}" ToolTip="{Binding Content}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="{Binding Kind, Converter={StaticResource ResIcon}}"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,14,0,0" Height="4">
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="2"/>
                            <Border x:Name="NowBar" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <!-- Tâche rythmée (Pomodoro…) : sessions pleines, pauses en pointillé -->
                        <Grid x:Name="RhythmBar" Margin="0,14,0,0" Height="6" Visibility="Collapsed"/>
                        <TextBlock x:Name="NextText" Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="24,0,0,0" MinWidth="120">
                        <TextBlock x:Name="Remaining" FontSize="38" FontWeight="Light" HorizontalAlignment="Right" Text="42:00"/>
                        <TextBlock x:Name="RemainingLabel" Style="{StaticResource Subtle}" HorizontalAlignment="Right" Text="{l:T today.remaining}"/>
                        <Button x:Name="NowDone" Style="{StaticResource Primary}" Margin="0,16,0,0" HorizontalAlignment="Right" Click="NowDone_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T today.done}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NowPostpone" Style="{StaticResource Ghost}" Margin="0,6,0,0" HorizontalAlignment="Right"
                                Click="NowPostpone_Click" ToolTip="{l:T today.postpone.tip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock x:Name="NowPostponeText" Text="{l:T today.postpone}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== État vide ===== -->
            <Border x:Name="EmptyCard" Grid.Row="1" Style="{StaticResource Card}" Padding="32" Visibility="Collapsed" Margin="0,0,0,28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{l:T today.empty.title}" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Subtle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,18"
                               Text="{l:T today.empty.sub}"/>
                    <Button Style="{StaticResource Primary}" Content="{l:T today.empty.plan}" HorizontalAlignment="Center" Click="Plan_Click"/>
                </StackPanel>
            </Border>

            <!-- ===== L'essentiel : deux ou trois choses, le reste peut attendre ===== -->
            <Border x:Name="EssentialCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,28" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentSoftBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{l:T today.essential.title}" Style="{StaticResource H2}" FontSize="16"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,12" Text="{l:T today.essential.sub}"/>
                    <ItemsControl x:Name="EssentialList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="erow" Background="{DynamicResource Surface2Brush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        Padding="14,11" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" VerticalAlignment="Center"
                                                  Click="Check_Click" Tag="{Binding}" Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasEmoji, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock x:Name="etitle" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding SlotText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"/>
                                                <TextBlock Text="{Binding StepsText}" FontSize="12" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                                Content="&#xE735;" Foreground="{DynamicResource AccentBrush}" Tag="{Binding}"
                                                Click="Unpin_Click" ToolTip="{l:T today.essential.remove}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="erow" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="etitle" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== À reprendre : ce qui n'a pas pu être fini avant ===== -->
            <Border x:Name="CarryCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,28" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="CarryTitle" Text="{l:T today.carry.title}" Style="{StaticResource H2}" FontSize="16"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,12"
                               Text="{l:T today.carry.sub}"/>
                    <ItemsControl x:Name="CarryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="crow" Background="{DynamicResource Surface2Brush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" VerticalAlignment="Center"
                                                  Click="Check_Click" Tag="{Binding}" Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ctitle" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CarriedText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Ghost}" Padding="10,6" Tag="{Binding}" Click="Schedule_Click"
                                                ToolTip="{l:T today.carry.schedule.tip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="{l:T today.carry.schedule}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="crow" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="ctitle" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Programme du jour ===== -->
            <DockPanel Grid.Row="4" Margin="0,0,0,12" x:Name="ListHeader">
                <TextBlock x:Name="Feedback" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Plan_Click" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T today.edit}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{l:T today.program}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            </DockPanel>

            <ItemsControl x:Name="TaskList" Grid.Row="5" Focusable="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="4,18,0,8"
                                           Visibility="{Binding Name, Converter={StaticResource NotNullVis}}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" Background="{DynamicResource ZoneRowBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="{DynamicResource CardBorder}" CornerRadius="{DynamicResource Radius}" Padding="16,13" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Liseré d'importance : se lit du coin de l'œil, sans rien avoir à déchiffrer -->
                                <Border x:Name="stripe" Width="3" CornerRadius="2" Margin="0,1,13,1" Background="Transparent"/>
                                <CheckBox x:Name="check" Grid.Column="1" Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" VerticalAlignment="Top"
                                          Click="Check_Click" Tag="{Binding}" Margin="0,0,16,0"/>
                                <!-- Un rendez-vous venu d'iCloud ne se coche pas : il ne nous appartient pas. -->
                                <TextBlock x:Name="extIcon" Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE787;" FontSize="13"
                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Top" Margin="2,2,16,0"
                                           Visibility="Collapsed"/>
                                <StackPanel Grid.Column="2" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding TimeRange}" FontSize="13" Foreground="{DynamicResource SubtleBrush}"/>
                                    <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" ToolTip="{l:T rhythm.badge.tip}"
                                                Visibility="{Binding RhythmBadge, Converter={StaticResource NotNullVis}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding RhythmBadge}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,9,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasEmoji, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Subtle}" Margin="0,5,0,0" LineHeight="19"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Étapes : on voit d'un coup d'œil qu'il y a une porte d'entrée, et combien en reste -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="10.5"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,1,6,0"/>
                                        <TextBlock Text="{Binding StepsText}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding NextStep.Title}" FontSize="11.5" Margin="8,0,0,0" MaxWidth="320"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,2,0,0">
                                    <Button x:Name="pin" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11"
                                            Content="&#xE734;" Margin="0,-2,6,0" Visibility="Hidden" Tag="{Binding}"
                                            Click="Pin_Click" ToolTip="{l:T today.essential.add}"/>
                                    <Button x:Name="postpone" Style="{StaticResource Ghost}" Padding="8,3" Margin="0,-3,6,0" FontSize="12"
                                            Visibility="Collapsed" Tag="{Binding}" Click="PostponeRow_Click"
                                            ToolTip="{l:T today.row.postpone.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="10" Margin="0,0,6,0"/>
                                            <TextBlock Text="{l:T today.row.postpone}"/>
                                        </StackPanel>
                                    </Button>
                                    <Border x:Name="breakTag" Visibility="Collapsed" Padding="8,2" CornerRadius="{DynamicResource RadiusPill}"
                                            Background="{DynamicResource Surface2Brush}" Margin="0,0,6,0">
                                        <TextBlock Text="{l:T today.row.break}" FontSize="11" Foreground="{DynamicResource BreakBrush}"/>
                                    </Border>
                                    <Border Padding="8,2" CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource Surface2Brush}"
                                            Margin="0,0,6,0" Visibility="{Binding ExternalCalendar, Converter={StaticResource NotNullVis}}"
                                            ToolTip="{l:T cal.external.tip}">
                                        <TextBlock Text="{Binding ExternalCalendar}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                                    </Border>
                                    <Border Padding="8,2" CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource Surface2Brush}"
                                            Visibility="{Binding CategoryId, Converter={StaticResource NotNullVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{Binding CategoryId, Converter={StaticResource CatBrush}}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding CategoryId, Converter={StaticResource CatName}}" FontSize="11"
                                                       Foreground="{DynamicResource SubtleBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="pin" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Dans « L'essentiel » : un trait net à gauche. C'est le seul repère d'importance. -->
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="stripe" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="pin" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="pin" Property="Content" Value="&#xE735;"/>
                                <Setter TargetName="pin" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                <Setter TargetName="breakTag" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="pin" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Rendez-vous iCloud : ni case, ni étoile, ni report. Kairn l'affiche et le contourne, point. -->
                            <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="extIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="pin" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="postpone" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                <Setter TargetName="row" Property="Opacity" Value="0.72"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPast}" Value="True"/>
                                    <Condition Binding="{Binding Done}" Value="False"/>
                                    <Condition Binding="{Binding IsBreak}" Value="False"/>
                                    <Condition Binding="{Binding IsExternal}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="postpone" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="row" Property="Opacity" Value="0.85"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="row" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ===================== Colonne latérale : outils et mails ===================== -->
        <StackPanel x:Name="Side" Grid.Column="2">

            <!-- ===== Mes outils ===== -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="ToolsManageBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" FontSize="12"
                                Content="{l:T tools.manage}" Click="ToolsManage_Click"/>
                        <TextBlock Text="{l:T tools.title}" Style="{StaticResource H2}" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="ToolsEmpty" Style="{StaticResource Subtle}" FontSize="12.5" Margin="0,0,0,10"
                               Text="{l:T tools.empty}"/>
                    <WrapPanel x:Name="ToolsPanel"/>

                    <!-- Gestion : ajouter depuis les programmes installés, un .exe ou un site -->
                    <StackPanel x:Name="ToolsManager" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBox x:Name="ToolSearch" Tag="{l:T tools.search}" TextChanged="ToolSearch_TextChanged"/>
                        <StackPanel x:Name="ToolResults" Margin="0,6,0,0"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="{l:T common.add}" Margin="6,0,0,0" Click="ToolUrl_Click"/>
                            <TextBox x:Name="ToolUrl" Tag="{l:T tools.url}" KeyDown="ToolUrl_KeyDown"/>
                        </DockPanel>
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ToolExe_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T tools.exe}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Mails ===== -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="MailActions">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE72C;" ToolTip="{l:T mail.refresh}" Click="MailRefresh_Click"/>
                            <Button x:Name="MailMenuBtn" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE712;" ToolTip="{l:T mail.options}" Click="MailMenu_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:T mail.title}" Style="{StaticResource H2}" FontSize="15"/>
                            <Border x:Name="UnreadBadge" Background="{DynamicResource AccentBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="UnreadText" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Pas encore liée -->
                    <StackPanel x:Name="MailSetup" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12.5" Margin="0,0,0,10"
                                   Text="{l:T mail.intro}"/>
                        <TextBox x:Name="MailEmail" Tag="{l:T mail.email.ph}" TextChanged="MailEmail_TextChanged"/>
                        <Border x:Name="MailHintBox" Background="{DynamicResource Surface2Brush}" CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="MailHint" FontSize="12" TextWrapping="Wrap"/>
                                <Button x:Name="MailHelpBtn" Style="{StaticResource Ghost}" Padding="0,4" HorizontalAlignment="Left" FontSize="12"
                                        Click="MailHelp_Click" Content="{l:T mail.help}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="MailServerBox" Visibility="Collapsed" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBox x:Name="MailPort" DockPanel.Dock="Right" Width="64" Margin="6,0,0,0" Text="993" Tag="{l:T mail.port}"/>
                                <TextBox x:Name="MailHost" Tag="{l:T mail.host}"/>
                            </DockPanel>
                        </StackPanel>
                        <PasswordBox x:Name="MailPassword" Margin="0,8,0,0" KeyDown="MailPassword_KeyDown"/>
                        <TextBlock Text="{l:T mail.password.label}" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="2,3,0,0"/>
                        <Button x:Name="MailConnectBtn" Style="{StaticResource Primary}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                Content="{l:T mail.connect}" Click="MailConnect_Click"/>

                        <!-- Alternative sans mot de passe -->
                        <Button Style="{StaticResource Ghost}" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="WebChoose_Click">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE774;" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{l:T mail.web.choose}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Button>
                        <StackPanel x:Name="WebChoices" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,8"
                                       Text="{l:T mail.web.intro}"/>
                            <WrapPanel x:Name="WebList"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="{l:T common.ok}" Margin="6,0,0,0" Click="WebCustom_Click"/>
                                <TextBox x:Name="WebCustom" Tag="{l:T mail.web.custom}" KeyDown="WebCustom_KeyDown"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Messagerie ouverte dans le navigateur -->
                    <StackPanel x:Name="MailWeb" Visibility="Collapsed">
                        <Button x:Name="WebOpenBtn" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Padding="14,10" Click="WebOpen_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource OnAccentBrush}"/>
                                <TextBlock x:Name="WebOpenText" Text="{l:T mail.web.openMine}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="WebFocusText" Style="{StaticResource Subtle}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,6" Margin="0,2,0,0" FontSize="12"
                                Content="{l:T mail.web.change}" Click="WebChange_Click"/>
                    </StackPanel>

                    <!-- Pendant un bloc de travail -->
                    <StackPanel x:Name="MailFocus" Visibility="Collapsed">
                        <TextBlock x:Name="MailFocusText" Style="{StaticResource Subtle}" FontSize="13"/>
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,6" Margin="0,4,0,0" FontSize="12.5"
                                Content="{l:T mail.showAnyway}" Click="MailShowAnyway_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="MailStatus" Style="{StaticResource Subtle}" FontSize="12.5" Margin="0,6,0,0" Visibility="Collapsed"/>

                    <!-- Liste -->
                    <ItemsControl x:Name="MailList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="m" Padding="8,8" Margin="-8,0,-8,2" CornerRadius="{DynamicResource RadiusSmall}" Background="Transparent"
                                        Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="MailItem_Down" MouseLeftButtonUp="MailItem_Up">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Date, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="11"
                                                       Foreground="{DynamicResource FaintBrush}" Margin="8,0,0,0"/>
                                            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="from" Text="{Binding From}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock x:Name="subj" Text="{Binding Subject}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Seen}" Value="False">
                                        <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="from" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="subj" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <Trigger SourceName="m" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="m" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Lecture d'un mail -->
                    <StackPanel x:Name="MailReader" Visibility="Collapsed">
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,4" Margin="0,0,0,8" Click="MailBack_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T mail.back}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ReadSubject" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReadFrom" FontSize="12" Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="ReadBody" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontSize="13" VerticalContentAlignment="Top"/>
                        </ScrollViewer>
                        <Button x:Name="ReadWebmail" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{l:T mail.reply}" Click="MailWebmail_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
