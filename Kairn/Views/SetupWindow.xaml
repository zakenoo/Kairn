<Window x:Class="Kairn.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kairn.Views"
        Title="Kairn" Width="940" Height="620" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border x:Name="Shell" Margin="18" CornerRadius="18" Background="{DynamicResource ZoneWindowBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" MouseLeftButtonDown="Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ===== Colonne de gauche : le cairn qui se construit ===== -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18,0,0,18">
                <Grid Margin="32,40,32,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Canvas x:Name="Cairn" Width="170" Height="150" HorizontalAlignment="Center" ClipToBounds="False"/>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Kairn" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="Steps" Grid.Row="3"/>
                </Grid>
            </Border>

            <!-- ===== Colonne de droite : les étapes ===== -->
            <Grid Grid.Column="1" Margin="44,34,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-18,0" Panel.ZIndex="5" Click="Close_Click"/>

                <Grid x:Name="Pages" Margin="0,18,0,0">
                    <!-- Bienvenue -->
                    <StackPanel x:Name="PageWelcome">
                        <TextBlock Text="{l:T setup.welcome.title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{l:T setup.welcome.sub}" Style="{StaticResource Subtle}" FontSize="14.5" LineHeight="22" Margin="0,12,0,28"/>
                        <TextBlock Text="{l:T setup.language}" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="LangChips"/>
                    </StackPanel>

                    <!-- Déjà installé -->
                    <StackPanel x:Name="PageExisting" Visibility="Collapsed">
                        <TextBlock Text="{l:T setup.existing.title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExistingText" Style="{StaticResource Subtle}" FontSize="14.5" LineHeight="22" Margin="0,12,0,24"/>
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Content="{l:T setup.reinstall}" Click="Reinstall_Click"/>
                    </StackPanel>

                    <!-- Ambiance -->
                    <DockPanel x:Name="PageTheme" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{l:T setup.theme.title}" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T setup.theme.sub}" Style="{StaticResource Subtle}" FontSize="14" Margin="0,8,0,16"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0">
                            <WrapPanel x:Name="ThemeGrid"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Réglages -->
                    <StackPanel x:Name="PagePrefs" Visibility="Collapsed">
                        <TextBlock Text="{l:T setup.prefs.title}" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T setup.prefs.name}" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                        <TextBox x:Name="NameBox" Tag="{l:T setup.prefs.name.ph}" MaxWidth="360" HorizontalAlignment="Left" Width="360"/>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,22,0,0"
                                  IsChecked="True" Content="{l:T setup.prefs.startup}"/>
                        <CheckBox x:Name="DesktopSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                  Content="{l:T setup.prefs.desktop}"/>
                        <CheckBox x:Name="UpdatesSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                  IsChecked="True" Content="{l:T setup.prefs.updates}"/>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" MaxWidth="440" HorizontalAlignment="Left"
                                   Text="{l:T setup.prefs.updates.sub}"/>
                        <TextBlock x:Name="WhereText" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,24,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Installation / mise à jour / désinstallation en cours -->
                    <StackPanel x:Name="PageWork" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="WorkTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="WorkStep" Style="{StaticResource Subtle}" FontSize="14" Margin="0,10,0,22"/>
                        <Grid Height="6">
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="3"/>
                            <Border x:Name="WorkBar" Background="{DynamicResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Terminé -->
                    <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="DoneTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DoneText" Style="{StaticResource Subtle}" FontSize="14.5" LineHeight="22" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Désinstallation -->
                    <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
                        <TextBlock Text="{l:T uninstall.title}" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T uninstall.sub}" Style="{StaticResource Subtle}" FontSize="14.5" LineHeight="22" Margin="0,12,0,24"/>
                        <CheckBox x:Name="DeleteDataSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Content="{l:T uninstall.deleteData}"/>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,6,0,0" Text="{l:T uninstall.keepHint}"/>
                    </StackPanel>
                </Grid>

                <!-- Navigation -->
                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,18,0,0">
                    <Button x:Name="BackBtn" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="{l:T setup.back}" Click="Back_Click"/>
                    <Button x:Name="NextBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="22,10" Click="Next_Click"/>
                    <Button x:Name="AltBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Margin="0,0,8,0" Visibility="Collapsed" Click="Alt_Click"/>
                    <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="360" Margin="12,0,0,0"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
