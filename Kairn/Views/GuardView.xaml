<UserControl x:Class="Kairn.Views.GuardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairn.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,8,44,40" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{l:T nav.guard}" Style="{StaticResource H1}" FontSize="24"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,20" MaxWidth="720" HorizontalAlignment="Left"
                       Text="{l:T guard.intro}"/>

            <!-- ===== Réaction ===== -->
            <TextBlock Text="{l:T guard.step1}" Style="{StaticResource Label}"/>
            <WrapPanel x:Name="ModeCards" Margin="0,0,0,4">
                <RadioButton Style="{StaticResource Chip}" GroupName="mode" Tag="Off" Checked="Mode_Checked" Width="200">
                    <StackPanel>
                        <TextBlock Text="{l:T guard.mode.off}" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T guard.mode.off.sub}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="mode" Tag="Gentle" Checked="Mode_Checked" Width="200">
                    <StackPanel>
                        <TextBlock Text="{l:T guard.mode.gentle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T guard.mode.gentle.sub}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="mode" Tag="CloseAtStart" Checked="Mode_Checked" Width="200">
                    <StackPanel>
                        <TextBlock Text="{l:T guard.mode.close}" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T guard.mode.close.sub}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="mode" Tag="Strict" Checked="Mode_Checked" Width="200">
                    <StackPanel>
                        <TextBlock Text="{l:T guard.mode.strict}" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T guard.mode.strict.sub}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
            </WrapPanel>
            <Border x:Name="StrictGate" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,10"
                    Background="{DynamicResource Surface2Brush}" CornerRadius="{DynamicResource RadiusSmall}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T guard.stayStrict}" Click="StrictCancel_Click"/>
                    <TextBlock x:Name="StrictGateText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <DockPanel Margin="0,4,0,24">
                <Button x:Name="SnoozeBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Snooze_Click"/>
                <TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap"/>
            </DockPanel>

            <!-- ===== Apps ===== -->
            <TextBlock Text="{l:T guard.step2}" Style="{StaticResource Label}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,12"
                       Text="{l:T guard.step2.sub}"/>
            <DockPanel Margin="0,0,0,14">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="gfilter" Content="{l:T lib.filter.all}" Margin="0,0,6,0" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterInstalled" Style="{StaticResource Chip}" GroupName="gfilter" Content="{l:T guard.filter.installed}" Margin="0,0,6,0" IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterOn" Style="{StaticResource Chip}" GroupName="gfilter" Content="{l:T guard.filter.on}" Margin="0" Checked="Filter_Checked"/>
                </WrapPanel>
                <TextBox x:Name="Search" Tag="{l:T guard.search}" TextChanged="Search_TextChanged"/>
            </DockPanel>
            <StackPanel x:Name="Groups"/>

            <!-- ===== Autre app ===== -->
            <TextBlock Text="{l:T guard.step3}" Style="{StaticResource Label}" Margin="0,12,0,6"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,12"
                               Text="{l:T guard.step3.sub}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Click="PickOpen_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE737;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock x:Name="PickOpenText" Text="{l:T guard.pickOpen}"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Click="Browse_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T tools.exe}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <WrapPanel x:Name="OpenApps" Margin="0,14,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,18,0,0"
                       Text="{l:T guard.privacy}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
