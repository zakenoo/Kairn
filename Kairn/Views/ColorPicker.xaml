<UserControl x:Class="Kairn.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairn.Views"
             FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius}" Padding="14" Width="262">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Saturation (horizontal) et luminosité (vertical) -->
            <Grid x:Name="SvArea" Width="232" Height="150" Cursor="Cross" ClipToBounds="True"
                  MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Any_Up">
                <Rectangle x:Name="HueFill" Fill="Red" RadiusX="6" RadiusY="6"/>
                <Rectangle RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6"/></Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Teinte -->
            <Grid x:Name="HueArea" Height="14" Margin="0,12,0,0" Cursor="Hand"
                  MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Any_Up">
                <Border CornerRadius="7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.167"/>
                            <GradientStop Color="#00FF00" Offset="0.333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.667"/>
                            <GradientStop Color="#FF00FF" Offset="0.833"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="HueThumb" Width="16" Height="16" Canvas.Top="-1" Fill="White" Stroke="#40000000" StrokeThickness="1"/>
                </Canvas>
            </Grid>

            <!-- Transparence -->
            <Grid x:Name="AlphaArea" Height="14" Margin="0,10,0,0" Cursor="Hand"
                  MouseLeftButtonDown="Alpha_Down" MouseMove="Alpha_Move" MouseLeftButtonUp="Any_Up">
                <Border CornerRadius="7" Background="{DynamicResource BgBrush}"/>
                <Border x:Name="AlphaFill" CornerRadius="7"/>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="AlphaThumb" Width="16" Height="16" Canvas.Top="-1" Fill="White" Stroke="#40000000" StrokeThickness="1"/>
                </Canvas>
            </Grid>
            <TextBlock Text="{l:T picker.alpha}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,0"/>

            <DockPanel Margin="0,10,0,0">
                <Border x:Name="Preview" DockPanel.Dock="Left" Width="36" Height="34" CornerRadius="{DynamicResource RadiusSmall}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                <TextBox x:Name="HexBox" KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus" FontFamily="Consolas"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
