<Window x:Class="Kairn.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kairn.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="620" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource AppFont}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" Opacity="0">
    <Border Margin="20" Background="{DynamicResource ZoneNudgeBrush}" BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius}" Padding="22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <!-- Le cairn, en tout petit : on reconnaît la fenêtre avant même de lire -->
                <Canvas Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse Canvas.Left="0" Canvas.Top="10" Width="16" Height="5" Fill="{DynamicResource AccentBrush}"/>
                    <Ellipse Canvas.Left="2.5" Canvas.Top="5.5" Width="11" Height="4" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                    <Ellipse Canvas.Left="5" Canvas.Top="1.5" Width="6.5" Height="3.5" Fill="{DynamicResource AccentBrush}" Opacity="0.7"/>
                </Canvas>
                <TextBlock x:Name="Header" Text="{l:T quick.title}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox x:Name="Box" FontSize="19" Padding="12,10" KeyDown="Box_KeyDown" TextChanged="Box_TextChanged"
                     Tag="{l:T quick.placeholder}"/>

            <TextBlock x:Name="Preview" Margin="4,10,0,0" FontSize="12.5" Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="Hint" Margin="4,10,0,0" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                       Text="{l:T quick.hint}" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
