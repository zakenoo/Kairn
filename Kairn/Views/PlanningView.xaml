<UserControl x:Class="Kairn.Views.PlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairn.Views">
    <Grid Margin="32,8,32,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== Calendrier ===== -->
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76C;" Click="NextMonth_Click"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76B;" Click="PrevMonth_Click"/>
                        <TextBlock x:Name="MonthTitle" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </DockPanel>
                    <UniformGrid x:Name="DayNames" Columns="7" Margin="0,0,0,4">
                        <TextBlock Text="L" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                        <TextBlock Text="M" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                        <TextBlock Text="M" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                        <TextBlock Text="J" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                        <TextBlock Text="V" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                        <TextBlock Text="S" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                        <TextBlock Text="D" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    </UniformGrid>
                    <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6"/>
                    <Button Style="{StaticResource Ghost}" Content="{l:T plan.today}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="Today_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T plan.ics.title}" Style="{StaticResource Label}"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,12"
                               Text="{l:T plan.ics.sub}"/>
                    <UniformGrid Columns="2">
                        <Button Margin="0,0,4,0" Click="Import_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T plan.import}"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="4,0,0,0" Click="Export_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T plan.export}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Journée sélectionnée ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock x:Name="DayLabel" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DayTitle" Style="{StaticResource H1}" FontSize="24" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Primary}" Click="Add_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T plan.task}"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Click="Paste_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T plan.paste}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="Duplicate_Click" ToolTip="{l:T plan.duplicate.tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T plan.duplicate}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Click="Clear_Click" ToolTip="{l:T plan.clear.tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T plan.clear}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Duplication : choix rapide -->
            <Border x:Name="DuplicatePanel" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed" Padding="16">
                <StackPanel>
                    <TextBlock Text="{l:T plan.dup.title}" Style="{StaticResource Label}"/>
                    <WrapPanel x:Name="DuplicateTargets" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0"
                               Text="{l:T plan.dup.sub}"/>
                </StackPanel>
            </Border>

            <!-- Éditeur de tâche -->
            <Border x:Name="Editor" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:T plan.ed.start}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="EdStart" Tag="{l:T time.ph.start}" TextChanged="Rhythm_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{l:T plan.ed.end}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="EdEnd" Tag="{l:T time.ph.end}" TextChanged="Rhythm_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{l:T plan.ed.task}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="EdTitle" Tag="{l:T plan.ed.task.ph}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,14,0,0">
                        <TextBlock Text="{l:T plan.ed.notes}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="EdNotes" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" Tag="{l:T plan.ed.notes.ph}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,14,0,0">
                        <TextBlock Text="{l:T plan.ed.category}" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="EdCategories"/>

                        <TextBlock Text="{l:T plan.ed.links}" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                        <WrapPanel x:Name="EdLinks"/>
                        <DockPanel Margin="0,2,0,0">
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Click="LinkFile_Click" ToolTip="{l:T plan.ed.file.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="{l:T plan.ed.file}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LinkToolBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Click="LinkTool_Click" ToolTip="{l:T plan.ed.tools.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74C;" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="{l:T plan.ed.tools}"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{l:T common.add}" Click="LinkAdd_Click"/>
                            <TextBox x:Name="LinkBox" Tag="{l:T plan.ed.link.ph}" KeyDown="LinkBox_KeyDown"/>
                        </DockPanel>
                        <CheckBox x:Name="EdAutoOpen" Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                  Content="{l:T plan.ed.autoOpen}"/>

                        <!-- Rythme : Pomodoro & co, calculé tout seul à partir de l'horaire -->
                        <TextBlock Text="{l:T rhythm.title}" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                        <WrapPanel x:Name="EdRhythm"/>
                        <StackPanel x:Name="EdRhythmCustom" Orientation="Horizontal" Margin="0,2,0,8" Visibility="Collapsed">
                            <TextBox x:Name="EdRhythmWork" Width="58" Tag="25" TextChanged="Rhythm_Changed"/>
                            <TextBlock Text="{l:T rhythm.custom.work}" VerticalAlignment="Center" Margin="8,0,16,0" Foreground="{DynamicResource SubtleBrush}"/>
                            <TextBox x:Name="EdRhythmPause" Width="58" Tag="5" TextChanged="Rhythm_Changed"/>
                            <TextBlock Text="{l:T rhythm.custom.pause}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SubtleBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="EdRhythmInfo" Style="{StaticResource Subtle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Margin="0,6,0,0">
                        <CheckBox x:Name="EdBreak" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Rhythm_Changed"
                                  Content="{l:T plan.ed.isBreak}"/>
                        <CheckBox x:Name="EdFloating" Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                  Content="{l:T plan.ed.floating}"/>
                        <DockPanel Margin="0,16,0,0" LastChildFill="False">
                            <Button x:Name="EdDelete" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Click="Delete_Click"
                                    Foreground="{DynamicResource DangerBrush}" Content="{l:T common.delete}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{l:T common.save}" Click="Save_Click" IsDefault="True"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T common.cancel}" Margin="0,0,8,0" Click="Cancel_Click"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="EdError" Grid.Row="4" Grid.ColumnSpan="5" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Collage d'un programme texte -->
            <Border x:Name="PastePanel" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{l:T plan.paste}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                   Text="{l:T plan.paste.help}"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource AccentBrush}"
                                   Text="{l:T plan.paste.rhythmHint}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PasteBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 FontSize="13" TextChanged="PasteBox_TextChanged"
                                 Tag="{l:T plan.paste.ph}"/>
                        <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" CornerRadius="{DynamicResource RadiusSmall}">
                            <DockPanel>
                                <TextBlock x:Name="PreviewCount" DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="14,12,14,6"
                                           Text="{l:T plan.paste.preview}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PreviewList" Margin="14,0,14,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource AccentBrush}" FontSize="12.5"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding RhythmBadge, Converter={StaticResource NotNullVis}}">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,1,5,0"/>
                                                            <TextBlock Text="{Binding RhythmBadge}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Subtle}" FontSize="12"
                                                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="{l:T plan.paste.category}" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="PasteCategories"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Style="{StaticResource Ghost}" Content="{l:T common.cancel}" Click="PasteCancel_Click"/>
                            <Button Content="{l:T plan.paste.replace}" Margin="8,0,0,0" Click="PasteReplace_Click"/>
                            <Button Style="{StaticResource Primary}" Content="{l:T plan.paste.add}" Margin="8,0,0,0" Click="PasteAdd_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Liste des tâches du jour -->
            <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Subtle}" Margin="4,8,0,0" FontSize="14"
                               Text="{l:T plan.emptyDay}"/>
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="{DynamicResource ZoneRowBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="{DynamicResource CardBorder}" CornerRadius="{DynamicResource Radius}" Padding="14,11" Margin="0,0,0,8"
                                        Cursor="Hand" MouseLeftButtonDown="Press" MouseLeftButtonUp="Row_Click" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="2" Background="{Binding CategoryId, Converter={StaticResource CatBrush}}" Margin="0,2,0,2"/>
                                        <TextBlock Grid.Column="1" x:Name="slot" Text="{Binding SlotText}" Foreground="{DynamicResource SubtleBrush}" Margin="12,1,0,0"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Section}" FontSize="11" Foreground="{DynamicResource FaintBrush}"
                                                       Visibility="{Binding Section, Converter={StaticResource NotNullVis}}"/>
                                            <TextBlock x:Name="title" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Subtle}" FontSize="12.5" Margin="0,3,0,0"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,1,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" ToolTip="{l:T rhythm.badge.tip}"
                                                        Visibility="{Binding RhythmBadge, Converter={StaticResource NotNullVis}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,1,5,0"/>
                                                <TextBlock Text="{Binding RhythmBadge}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource FaintBrush}" FontSize="12"/>
                                        </StackPanel>
                                        <!-- Suppression rapide (annulable), visible au survol -->
                                        <Button x:Name="del" Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11.5"
                                                Content="&#xE74D;" Margin="10,-4,-6,-4" VerticalAlignment="Top" Visibility="Hidden"
                                                Tag="{Binding}" Click="QuickDelete_Click" ToolTip="{l:T plan.row.delete}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="del" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Floating}" Value="True">
                                        <Setter TargetName="slot" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <l:UndoBar x:Name="Undo" Grid.Row="2"/>
        </Grid>
    </Grid>
</UserControl>
