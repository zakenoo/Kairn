<UserControl x:Class="Kairn.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairn.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,8,44,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{l:T nav.settings}" Style="{StaticResource H1}" FontSize="24" Margin="0,0,0,20"/>

            <!-- ===== Langue ===== -->
            <TextBlock Text="{l:T set.language}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <WrapPanel x:Name="LanguageChips"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T set.language.folder}" Click="OpenLang_Click" Margin="12,0,0,0"/>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" Text="{l:T set.language.help}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Toi ===== -->
            <TextBlock Text="{l:T set.you}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <DockPanel>
                    <TextBox x:Name="NameBox" DockPanel.Dock="Right" Width="240" Tag="{l:T set.optional}" LostFocus="NameBox_LostFocus"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T set.name}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" Text="{l:T set.name.sub}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Rythme de travail ===== -->
            <TextBlock Text="{l:T set.rhythm}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{l:T set.rhythm.auto}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap" Text="{l:T set.rhythm.auto.sub}"/>
                    <WrapPanel x:Name="AutoRhythmChips"/>
                    <StackPanel x:Name="AutoRhythmMinRow" Margin="0,8,0,0">
                        <TextBlock Text="{l:T set.rhythm.min}" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="AutoRhythmMinChips"/>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8,0,14"/>
                    <CheckBox x:Name="RhythmSoundSwitch" Style="{StaticResource Switch}" Content="{l:T set.rhythm.sound}" Click="RhythmSound_Click"/>
                </StackPanel>
            </Border>

            <!-- ===== Assistant d'objectifs ===== -->
            <TextBlock Text="{l:T set.ai}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T set.ai.local}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap" Text="{l:T set.ai.local.sub}"/>
                    <WrapPanel x:Name="LocalSourceChips"/>

                    <!-- Modèle intégré -->
                    <StackPanel x:Name="BuiltinPanel" Margin="0,4,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UninstallBtn" Style="{StaticResource Ghost}" Content="{l:T set.ai.uninstall}" Click="Uninstall_Click"
                                        Foreground="{DynamicResource DangerBrush}"/>
                                <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="{l:T set.ai.install}" Click="Install_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="EngineStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                        <StackPanel x:Name="InstallProgressPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <ProgressBar x:Name="InstallProgress" Height="4" Maximum="1" Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource Surface2Brush}" BorderThickness="0"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T common.cancel}" Click="CancelInstall_Click"/>
                                <TextBlock x:Name="InstallText" Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                        <CheckBox x:Name="GpuSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                  Content="{l:T set.ai.gpu}" Click="Gpu_Click"/>
                    </StackPanel>

                    <!-- Ollama / LM Studio déjà installés -->
                    <StackPanel x:Name="ServerPanel" Margin="0,4,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T set.ai.refresh}" Click="RefreshServer_Click"/>
                            <TextBlock x:Name="ServerStatus" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel x:Name="ServerModels" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <CheckBox x:Name="OnlineSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Content="{l:T set.ai.online}" Click="Online_Click"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:T set.ai.online.sub}"/>
                    <StackPanel x:Name="OnlinePanel" Margin="0,12,0,0">
                        <WrapPanel x:Name="ProviderChips"/>
                        <TextBlock Text="{l:T set.ai.key}" Style="{StaticResource Label}" Margin="0,6,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{l:T common.save}" Click="SaveKey_Click" Margin="8,0,0,0"/>
                            <PasswordBox x:Name="KeyBox"/>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button x:Name="ForgetKeyBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T set.ai.key.forget}" Click="ForgetKey_Click"/>
                            <TextBlock x:Name="KeyStatus" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T set.ai.model}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ModelBox" LostFocus="OnlineField_LostFocus"/>
                            </StackPanel>
                            <StackPanel x:Name="BaseUrlPanel" Grid.Column="2">
                                <TextBlock Text="{l:T set.ai.url}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="BaseUrlBox" Tag="https://api.openai.com/v1" LostFocus="OnlineField_LostFocus"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="WebSearchSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                  Content="{l:T set.ai.search}" Click="WebSearch_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Mises à jour ===== -->
            <TextBlock Text="{l:T set.updates}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T set.updates.check}" Click="CheckUpdates_Click" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionLabel" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,14"/>
                    <CheckBox x:Name="UpdatesSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left" Content="{l:T setup.prefs.updates}" Click="UpdatesSwitch_Click"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" Text="{l:T setup.prefs.updates.sub}"/>
                </StackPanel>
            </Border>

            <!-- ===== Système ===== -->
            <TextBlock Text="{l:T set.system}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="{l:T set.startup}"
                              Click="StartupSwitch_Click"/>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,14"/>
                    <CheckBox x:Name="TraySwitch" Style="{StaticResource Switch}"
                              Content="{l:T set.tray}" Click="TraySwitch_Click"/>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,14"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T set.openFolder}" Click="OpenData_Click"/>
                        <StackPanel>
                            <TextBlock Text="{l:T set.data}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DataPath" Style="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Subtle}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="{l:T set.footer}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
